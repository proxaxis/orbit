---
import { Image } from 'astro:assets';
import { APP_URL } from '../consts';
import logo from '../assets/logos/icon_round_120x120.png';
import IconBars from './icons/IconBars.vue';
import IconXMark from './icons/IconXMark.vue';

const links = [
  { href: '/#features', label: '特徴' },
  { href: '/#screenshots', label: '画面イメージ' },
  { href: '/privacy', label: 'プライバシー' },
  { href: '/terms', label: '利用規約' },
];
---

<header class="site-header">
  <div class="site-header-inner">
    <a href="/" class="brand">
      <Image src={logo} alt="Orbit カレンダー" width={128} height={128} class="brand-logo" />
      <span class="brand-name">Orbitカレンダー</span>
    </a>
    <nav class="nav-desktop">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
      <a href={APP_URL} class="app-btn" target="_blank" rel="noopener">アプリを開く</a>
    </nav>
    <details class="nav-mobile">
      <summary aria-label="メニュー">
        <IconBars size="1.3rem" class="icon-open" />
        <IconXMark size="1.3rem" class="icon-close" />
      </summary>
      <nav class="mobile-menu">
        <a href={APP_URL} class="menu-app" target="_blank" rel="noopener">アプリを開く</a>
        {links.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>
    </details>
  </div>
</header>

<script>
  const menu = document.querySelector('.nav-mobile');
  if (menu instanceof HTMLDetailsElement) {
    menu.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) {
        menu.open = false;
      }
    });
    document.addEventListener('click', (event) => {
      if (menu.open && event.target instanceof Element && !event.target.closest('.nav-mobile')) {
        menu.open = false;
      }
    });
  }
</script>

<style lang="scss">
  @use '../styles/vars' as *;

  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--site-bg) 85%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--site-border);
  }

  .site-header-inner {
    position: relative;
    max-width: var(--site-max-width);
    margin: 0 auto;
    padding: 0.6rem var(--space-md);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--site-text);
    font-weight: 700;
    font-size: 1.05rem;

    @include mdown(sm) {
      font-size: 0.95rem;
    }
  }

  .brand-logo {
    border-radius: 8px;
    display: block;
    width: 2.4rem;
    height: 2.4rem;
  }

  .nav-desktop {
    display: flex;
    gap: var(--space-md);
    font-size: 0.9rem;
    align-items: center;

    a {
      color: var(--site-text-sub);
      text-decoration: none;
      white-space: nowrap;

      &:hover {
        color: var(--site-accent);
      }
    }

    @include mdown(sm) {
      display: none;
    }
  }

  .app-btn {
    display: inline-flex;
    align-items: center;
    padding: 0.45rem 1.1rem;
    border-radius: 999px;
    background: var(--site-accent);
    color: #fff !important;
    font-weight: 700;
    white-space: nowrap;

    &:hover {
      background: var(--site-accent-dark);
      color: #fff !important;
    }
  }

  .nav-mobile {
    display: none;
    position: relative;

    @include mdown(sm) {
      display: block;
    }

    summary {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 2.4rem;
      height: 2.4rem;
      border-radius: 8px;
      color: var(--site-text);
      cursor: pointer;
      list-style: none;

      &::-webkit-details-marker {
        display: none;
      }

      &:hover {
        background: var(--site-bg-alt);
      }
    }

    .icon-close {
      display: none;
    }

    &[open] {
      .icon-open {
        display: none;
      }

      .icon-close {
        display: block;
      }
    }
  }

  .mobile-menu {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    z-index: 200;
    min-width: 12rem;
    display: flex;
    flex-direction: column;
    padding: 0.4rem;
    background: #fff;
    border: 1px solid var(--site-border);
    border-radius: var(--site-radius);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.12);

    a {
      padding: 0.65rem 0.8rem;
      border-radius: 8px;
      color: var(--site-text);
      text-decoration: none;
      font-size: 0.95rem;

      &:hover {
        background: var(--site-bg-alt);
        color: var(--site-accent);
      }
    }

    .menu-app {
      margin-bottom: 0.3rem;
      background: var(--site-accent);
      color: #fff;
      font-weight: 700;
      text-align: center;

      &:hover {
        background: var(--site-accent-dark);
        color: #fff;
      }
    }
  }
</style>
