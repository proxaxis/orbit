---
import { Image } from 'astro:assets';
import { APP_URL } from '../consts';
import logo from '../assets/logos/icon_round_120x120.png';
---

<footer class="site-footer">
  <div class="site-footer-inner">
    <div class="footer-brand">
      <Image src={logo} alt="Orbit Calendar" width={28} height={28} class="footer-logo" />
      <span>Orbit Calendar</span>
    </div>
    <nav class="footer-nav">
      <a href={APP_URL} target="_blank" rel="noopener">アプリを開く</a>
      <a href="/privacy">プライバシーポリシー</a>
      <a href="/terms">利用規約</a>
    </nav>
    <p class="copyright">&copy; 2026 Orbit Calendar</p>
  </div>
</footer>

<style lang="scss">
  .site-footer {
    border-top: 1px solid var(--site-border);
    background: var(--site-bg-alt);
  }

  .site-footer-inner {
    max-width: var(--site-max-width);
    margin: 0 auto;
    padding: var(--space-lg) var(--space-md);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
    text-align: center;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
  }

  .footer-logo {
    border-radius: 7px;
  }

  .footer-nav {
    display: flex;
    gap: var(--space-md);
    font-size: 0.85rem;

    a {
      color: var(--site-text-sub);
      text-decoration: none;

      &:hover {
        color: var(--site-accent);
      }
    }
  }

  .copyright {
    font-size: 0.8rem;
    color: var(--site-text-sub);
  }
</style>
